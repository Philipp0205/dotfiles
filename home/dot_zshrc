# Function to open Eclipse EGit with custom or default workspace
ecl-egit() {
    local workspace="${1:-$HOME/Documents/eclipse-workspaces/pull-request-plugin}"
    
    # If argument is a relative or absolute worktree path, create workspace name from it
    if [ -d "$1" ]; then
        local worktree_name=$(basename "$1")
        workspace="$HOME/Documents/eclipse-workspaces/$worktree_name"
        echo "Opening Eclipse with workspace: $workspace"
        echo "For worktree: $1"
    fi
    
    cd ~ && ~/.eclipse/egit-master/eclipse/eclipse -nosplash -data "$workspace" -vmargs -Dcom.genuitec.eclipse.startup.eclipse.hideStartupDialog=true &>/dev/null & disown
}


